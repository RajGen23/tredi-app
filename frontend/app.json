{
  "expo": {
    "name": "TradaBooks",
    "slug": "tradabooks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tradabooks",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brandjunction.tredi",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan bar codes and snap supplier bills",
        "NSPhotoLibraryUsageDescription": "Attach a bill photo to an expense",
        "NSFaceIDUsageDescription": "Unlock your books with Face ID",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00C98D"
      },
      "package": "com.brandjunction.tredi",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00C98D"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan bar codes and snap supplier bills"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your books with Face ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/images/splash-green.png",
      "resizeMode": "contain",
      "backgroundColor": "#00C98D"
    },
    "backgroundColor": "#00C98D"
  }
}
